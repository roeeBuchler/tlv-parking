{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tlv-parking",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "not_found_handling": "none" },
  "observability": { "enabled": true },
  // users + favorites. One time: `npx wrangler d1 create tlv-parking`, paste its database_id here
  "d1_databases": [{ "binding": "DB", "database_name": "tlv-parking", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
